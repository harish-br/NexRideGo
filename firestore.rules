rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= USERS =================
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ================= DRIVERS =================
    match /drivers/{driverId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == driverId;
    }

    // ================= TRIPS =================
    match /trips/{tripId} {
      // User creates trip
      allow create: if request.auth != null;

      // User can read/update their own trip
      allow read, update: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Driver can read/update assigned trip
      allow read, update: if request.auth != null
        && (resource.data.driverId == request.auth.uid || request.resource.data.driverId == request.auth.uid);
    }

    // ================= DRIVER REQUESTS =================
    match /driverRequests/{driverId}/trips/{tripId} {
      // User creates request
      allow create: if request.auth != null;

      // Driver reads and deletes (write) their own requests
      allow read, write: if request.auth != null
        && request.auth.uid == driverId;
    }
  }
}
